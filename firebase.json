{
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4010
    },
    "singleProjectMode": true
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "apphosting": [
    {
      "backendId": "web",
      "rootDir": "/",
      "alwaysDeployFromSource": true,
      "ignore": [
        "node_modules",
        ".git",
        "/.github",
        "/.claude",
        "/dist",
        "/coverage",
        "/emulator-data",
        "/e2e",
        "/tests",
        "/playwright-report",
        "/test-results",
        "firebase-debug.log",
        "firestore-debug.log"
      ]
    }
  ],
  "hosting": [
    {
      "site": "davebiehlart-admin",
      "public": "dist/admin/browser",
      "ignore": ["**/.*"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        {
          "source": "**",
          "headers": [{ "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }]
        }
      ]
    }
  ]
}
