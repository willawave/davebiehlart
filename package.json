{
  "name": "davebiehlart",
  "version": "1.0.1",
  "scripts": {
    "ng": "ng",
    "start": "firebase emulators:exec --project demo-bronze-horse --only auth,firestore,storage --import ./emulator-data --ui \"pnpm run '/^dev:/'\"",
    "dev:web": "ng serve web",
    "dev:admin": "ng serve admin",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:web": "node dist/web/server/server.mjs",
    "emulators": "firebase emulators:start --project demo-bronze-horse --only auth,firestore,storage --import ./emulator-data",
    "emulators:export": "firebase emulators:export ./emulator-data --project demo-bronze-horse --force",
    "test:rules": "firebase emulators:exec --project demo-bronze-horse-rules --only auth,firestore,storage \"node --test --test-concurrency=1 tests/rules/*.test.mjs\"",
    "lint": "ng lint",
    "brand": "node brand/generate.mjs",
    "e2e": "firebase emulators:exec --project demo-bronze-horse --only auth,firestore,storage --import ./emulator-data \"playwright test\""
  },
  "private": true,
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-server": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/ssr": "^22.2.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@ngrx/signals": "^22.0.1",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "firebase": "^12.19.0",
    "ol": "^10.11.0",
    "rxjs": "~7.8.0",
    "sharp": "^0.35.5",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.5.0",
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "1.63.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "22.5.0",
    "eslint": "^10.12.0",
    "firebase-tools": "15.32.1",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.2.4",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^4.0.8"
  }
}
